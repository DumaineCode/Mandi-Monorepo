# Build context is the repo root, so this ignore list keeps the context small
# and prevents stale/host-specific artifacts from leaking into the image.

# Dependencies (reinstalled fresh inside the image)
node_modules
**/node_modules

# Medusa build output (regenerated inside the builder stage)
**/.medusa

# Framework / build artifacts
**/.next
**/out
**/dist
**/build
**/.turbo
**/coverage

# Secrets & local env (injected by Dokploy at runtime instead)
**/.env
**/.env.*
*.pem

# Git & tooling
.git
.gitignore
**/.DS_Store

# Editor / OS noise
.idea
.vscode
*.log

# Agent / spec tooling — never read by a build, but shipped to the daemon on
# every deploy if left in. .codegraph alone is ~9MB of index nobody needs.
.codegraph
.agents
.atl
.turbo
openspec
wireframes
docs
skills-lock.json
opencode.json

# Tests and fixtures: the runtime image never executes them
**/integration-tests
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
