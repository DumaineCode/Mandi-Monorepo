STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-backend

# --- Provider settings (change: admin-provider-settings) ---
# Provider credentials now live ENCRYPTED IN THE DATABASE, managed from the
# Admin panel (Provider Settings). Only the two vars below remain env-based.

# ACTIVE — Key-Encryption Key for provider secrets (AES-256-GCM). REQUIRED.
# Must be base64 OR hex decoding to exactly 32 bytes. Generate one with:
#   openssl rand -base64 32
# Losing this key means all stored provider secrets become undecryptable and
# every provider resolves as unconfigured — re-paste credentials via the admin
# panel after setting a new key. Keep it stable and backed up per environment.
PROVIDER_SETTINGS_ENCRYPTION_KEY=

# ACTIVE — Publicly reachable backend URL used to build MP notification_url
# (webhooks). Stays env-based (not stored in the DB).
BACKEND_PUBLIC_URL=

# --- File storage (Cloudflare R2) ---
# Where uploaded files (product images, mostly) are stored. Leave the block
# empty in development and Medusa falls back to the local provider, which writes
# to ./static and serves http://localhost:9000/static/... — fine on your laptop.
# PRODUCTION REFUSES TO BOOT without the five required vars below, on purpose:
# the local provider stores files inside the container, so a redeploy wipes them
# while the database keeps pointing at the now-missing images.

# Cloudflare account ID. Only used to build the S3 endpoint the backend writes
# to: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=

# Bucket name, exactly as it appears in the Cloudflare R2 dashboard.
R2_BUCKET=

# Credentials from an R2 API token with "Object Read & Write", scoped to THIS
# bucket only. Account-wide tokens work too but hand a compromised backend
# write access to every bucket you own.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# PUBLIC base URL images are served from — the custom domain you connected to
# the bucket, e.g. https://cdn.example.com. NOT the
# *.r2.cloudflarestorage.com endpoint above: that one is private and answers
# only signed requests, so every image would come back 401.
# This value is BAKED INTO EVERY IMAGE ROW the database stores, not resolved at
# read time. Changing it later does not migrate anything — you have to rewrite
# the existing rows yourself. Pick a domain you control long-term.
# No trailing slash (one is stripped anyway, since URLs are built as
# <R2_PUBLIC_URL>/<key>).
R2_PUBLIC_URL=

# Optional key prefix. Write it however you like — "media", "media/" and
# "/media/" all end up as "media/". The trailing slash is what makes it a folder
# (the provider concatenates it raw as `${prefix}${name}-${ulid}${ext}`, so a
# bare "media" would write "mediaphoto-01ABC.jpg" at the bucket root), and a
# leading slash would put a double slash in every public URL — the backend
# normalizes both away before handing the value to the provider. Useful to share
# one bucket between environments; omit it and objects land at the bucket root.
R2_PREFIX=

# --- DEPRECATED provider env vars (removal window) ---
# The vars below are read ONCE by the one-time seed:
#   npx medusa exec ./src/scripts/seed-provider-settings.ts
# to import existing credentials into the encrypted DB store. After the seed has
# run, the DB is strictly authoritative — these vars are NOT consulted at
# runtime (changing them has no effect). Populate them ONLY for the initial
# migration seed, then remove them once every environment is seeded. Manage all
# provider credentials from the Admin > Provider Settings panel going forward.

# DEPRECATED (seed-only) — Openpay (cards + 3DS)
#   required set for seed: MERCHANT_ID, PRIVATE_KEY, WEBHOOK_USER, WEBHOOK_PASSWORD
OPENPAY_MERCHANT_ID=
OPENPAY_PRIVATE_KEY=
OPENPAY_PUBLIC_KEY=
# "true" (default) seeds sandbox mode; "false" seeds production mode.
OPENPAY_SANDBOX=true
OPENPAY_WEBHOOK_USER=
OPENPAY_WEBHOOK_PASSWORD=

# DEPRECATED (seed-only) — Mercado Pago (Checkout Pro)
#   required set for seed: ACCESS_TOKEN, WEBHOOK_SECRET, BACKEND_PUBLIC_URL
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# DEPRECATED (seed-only) — Skydropx (fulfillment quotes + labels)
#   required set for seed: API_KEY, ORIGIN_ZIP
SKYDROPX_API_KEY=
# Optional override; defaults to https://api.skydropx.com/v1
SKYDROPX_BASE_URL=
SKYDROPX_ORIGIN_ZIP=
# Optional; "false" opts out of tax-inclusive pricing (default is inclusive).
SKYDROPX_TAX_INCLUSIVE=
